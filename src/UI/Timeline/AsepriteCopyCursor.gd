extends RefCounted
## Original 16x16 cursor_normal_add from the Aseprite Default Theme.
## Source: https://github.com/aseprite/aseprite/blob/main/data/extensions/aseprite-theme/sheet.png
## License: CC BY 4.0 (David Capello and Ilija Melentijevic, 2009-2017).
## The upstream PNG is embedded losslessly as Base64 because GitHub's text-based
## repository API cannot upload binary files. Only (80, 16, 16, 16) is used.
## Attribution and license details: res://src/UI/Timeline/ASEPRITE_CURSOR_LICENSE.md

const SOURCE_SHEET_PNG_BASE64 := ""
const CURSOR_REGION := Rect2i(80, 16, 16, 16)


static func create_copy_cursor() -> ImageTexture:
	var sheet := Image.new()
	var bytes := Marshalls.base64_to_raw(SOURCE_SHEET_PNG_BASE64)
	var error := sheet.load_png_from_buffer(bytes)
	if error != OK:
		push_error("Unable to load Aseprite copy cursor: %s" % error_string(error))
		return null
	var cursor_image := sheet.get_region(CURSOR_REGION)
	return ImageTexture.create_from_image(cursor_image)
